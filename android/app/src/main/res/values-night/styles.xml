<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The site has one light design, so night mode keeps the same cream start -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/almas_surface</item>
        <item name="android:navigationBarColor">@color/almas_surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/almas_surface</item>
        <item name="android:statusBarColor">@color/almas_surface</item>
        <item name="android:navigationBarColor">@color/almas_surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
