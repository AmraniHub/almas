<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws its own splash: cream background and the shop's logo -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/almas_surface</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/almas_icon_bg</item>
        <item name="android:statusBarColor">@color/almas_surface</item>
        <item name="android:navigationBarColor">@color/almas_surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/almas_surface</item>
        <item name="android:statusBarColor">@color/almas_surface</item>
        <item name="android:navigationBarColor">@color/almas_surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
